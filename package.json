{
  "name": "astralight",
  "version": "0.0.0",
  "private": true,
  "description": "📦️ This repository that contains an Astro template ready for any website you can imagine. Offering pre-built modules and flexible configurations to kickstart your project, regardless of its type.",
  "author": "Luis Monsalve>",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "preview": "astro preview",
    "build": "rm -rf ./dist && astro check && bun lint && bun format && astro build",
    "setup": "bunx gitlys init",
    "lint": "bun lint:oxlint && bun lint:stylelint && bun lint:terraform",
    "lint:oxlint": "bunx oxlint --fix",
    "format": "bunx oxfmt",
    "lint:stylelint": "stylelint ./src/**/*.{scss,css} --fix",
    "lint:terraform": "terraform -chdir=infrastructure fmt",
    "convert:typography": "bun ./script/conversion/typography.ts",
    "tf:init": "terraform -chdir=infrastructure init",
    "tf:plan:dev": "terraform -chdir=infrastructure plan -var-file=dev.tfvars -out=dev.tfplan",
    "tf:apply:dev": "terraform -chdir=infrastructure apply \"dev.tfplan\"",
    "tf:destroy:dev": "terraform -chdir=infrastructure destroy -var-file=dev.tfvars",
    "tf:plan:prod": "terraform -chdir=infrastructure plan -var-file=prod.tfvars -out=prod.tfplan",
    "tf:apply:prod": "terraform -chdir=infrastructure apply \"prod.tfplan\"",
    "tf:destroy:prod": "terraform -chdir=infrastructure destroy -var-file=prod.tfvars",
    "deploy": "bun ./infrastructure/deploy.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/partytown": "2.1.8",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fullhuman/postcss-purgecss": "8.0.0",
    "@stacklys/browserslist-config": "1.0.0",
    "@stacklys/oxlint-config": "1.0.4",
    "@stacklys/tsconfig": "1.0.2",
    "@types/node": "26.6.5",
    "@types/ttf2woff": "2.0.4",
    "astro": "7.4.0",
    "astro-class-shortener": "1.0.4",
    "astro-crush": "1.0.0",
    "astro-inline-css": "1.1.1",
    "astro-lang-i18n": "1.0.0",
    "astro-meta-engine": "1.0.5",
    "autoprefixer": "10.6.1",
    "envlys": "1.0.5",
    "gitlys": "2.2.4",
    "lenis": "1.3.27",
    "logginlys": "4.0.2",
    "postcss": "8.5.30",
    "sass": "1.105.2",
    "structured-data-types": "1.0.0",
    "stylelint-config-universal-code": "1.0.11",
    "ttf2woff": "3.0.0",
    "ttf2woff2": "8.0.1"
  },
  "browserslist": [
    "extends @stacklys/browserslist-config"
  ],
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.17.0"
  }
}