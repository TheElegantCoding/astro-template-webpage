{
  "extends": ["@stacklys/tsconfig/strict", "@stacklys/tsconfig/dom"],
  "compilerOptions": {
    "paths": {
      "@global/*": ["./src/global/*"],
      "@module/*": ["./src/module/*"],
      "@public/*": ["./public/*"],
      "@script/*": ["./script/*"]
    }
  },
  "include": ["./src/**/*"],
  "exclude": ["./dist"]
}