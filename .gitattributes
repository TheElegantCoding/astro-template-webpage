*.rar   binary
*.tar   binary
*.zip   binary
*.pdf   binary
*.psd   binary
*.ai    binary
*.gif   binary
*.ico   binary
*.jpg   binary
*.png   binary
*.webp  binary
*.avif  binary

# Binary: media and fonts
*.mp4   binary
*.webm  binary
*.mov   binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.ttf   binary
*.otf   binary
*.eot   binary
