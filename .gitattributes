# Normalize line endings by default
* text=auto eol=lf

# Source and config
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.fish      text eol=lf
*.lua       text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.ts        text eol=lf
*.jsx       text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.desktop   text eol=lf
*.rasi      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf

# Dotfiles and env
*.env       text eol=lf
*.env.*     text eol=lf
*.example   text eol=lf
*rc         text eol=lf
*ignore     text eol=lf
.editorconfig  text eol=lf
.gitattributes text eol=lf

# Binary: archives, documents, images
